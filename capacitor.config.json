{
  "appId": "com.telenotes.dev",
  "appName": "Telenotes Dev",
  "webDir": "dist",
  "server": {
    "errorPath": "index.html",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "https://*.github.io",
      "https://*.run.app",
      "http://localhost:*",
      "*"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#020617",
    "buildOptions": {
      "keystorePath": null,
      "keystorePassword": null
    }
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#020617"
    },
    "NavigationBar": {
      "displaysInLowProfile": false,
      "backgroundColor": "#020617"
    }
  }
}
